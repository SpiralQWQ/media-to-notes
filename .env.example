# media-to-notes 环境变量（全部可省略；省略时脚本基于自身目录自动推导）
# 复制为 .env 后需 `pip install python-dotenv` 才会被自动加载。

# 项目数据根目录（视频/音频/图片/文本/NoteBooks/temp 都建在这里）
DD_BASE=

# 抖音下载器 douyin-downloader 的 Python 解释器（独立 venv 时填写）
DD_DL_PY=

# douyin-downloader 源码/包目录（含 run.py；未设置时默认 <仓库根>/douyin-downloader）
DD_DL_SRC=

# FunASR 转写用 Python 解释器
DD_ASR_PY=

# OCR 脚本用 Python 解释器（RapidOCR / PaddleOCR）
DD_OCR_PY=

# yt-dlp 可执行文件路径（默认 yt-dlp，需在 PATH；仅使用抖音链接时无需设置）
DD_YTDLP=

# GLM 视觉分析 API Key（可选，--glm yes 时需要，BigModel 开放平台申请）
GLM_API_KEY=

# media-to-notes 环境变量（全部可省略；省略时脚本基于自身目录自动推导）
# 复制为 .env 后需 `pip install python-dotenv` 才会被自动加载。

# 项目数据根目录（视频/音频/图片/文本/NoteBooks/temp 都建在这里）
DD_BASE=

# 抖音下载器 douyin-downloader 的 Python 解释器（独立 venv 时填写）
DD_DL_PY=

# douyin-downloader 源码/包目录（含 run.py；未设置时默认 <仓库根>/douyin-downloader）
DD_DL_SRC=

# FunASR 转写用 Python 解释器
DD_ASR_PY=

# OCR 脚本用 Python 解释器（RapidOCR / PaddleOCR）
DD_OCR_PY=

# yt-dlp 可执行文件路径（默认 yt-dlp，需在 PATH；仅使用抖音链接时无需设置）
DD_YTDLP=

# GLM 视觉分析 API Key（可选，--glm yes 时需要，BigModel 开放平台申请）
GLM_API_KEY=

# ── 开箱即用配置（由 python setup.py 生成，也可手动填）──

# 视频画面 OCR 频率：秒数间隔（如 1=每秒1帧，0.5=每秒2帧），或 scene=画面变化才抽，no=不OCR
OCR_INTERVAL=1

# GLM 画面理解模式：yes=只关键帧(省钱) / all=每帧(贵) / no=不用GLM
GLM_MODE=no

# 笔记正文语言：zh=中文(术语中英对照) / en=英文 / auto=跟随内容
NOTE_LANG=zh

# 笔记末尾是否保留完整转写附录：true / false
KEEP_APPENDIX=true

# 费曼思考题密度：10=核心10/重要8/一般6 / 6=精简6/4/3 / 0=不要
FEYNMAN_DENSITY=6

# 转写中间产物是否保留到缓存：true / false
KEEP_MIDDLE=true

# 笔记目录组织：date=按日期 / topic=按课程主题分目录
NOTE_ORGANIZE=date
